---
const isRussian = Astro.currentLocale === 'ru' || Astro.url.pathname.startsWith('/docs/ru/')
const appLabel = isRussian
  ? 'Вернуться в приложение Okoscope'
  : 'Return to the Okoscope application'
---

<a href="/" class="okoscope-brand" aria-label={appLabel}>
  <svg viewBox="0 0 96 72" aria-hidden="true" class="okoscope-brand-mark">
    <defs>
      <linearGradient id="docs-brand-gradient" x1="10" y1="58" x2="86" y2="14">
        <stop stop-color="#3458ff"></stop>
        <stop offset="0.48" stop-color="#08b9ff"></stop>
        <stop offset="1" stop-color="#15f0bd"></stop>
      </linearGradient>
    </defs>
    <path
      d="M8 36c11-15 24-23 40-23s29 8 40 23C77 51 64 59 48 59S19 51 8 36Z"
      fill="none"
      stroke="url(#docs-brand-gradient)"
      stroke-width="6"
      stroke-linejoin="round"
    ></path>
    <circle
      cx="48"
      cy="36"
      r="18"
      fill="#071526"
      stroke="url(#docs-brand-gradient)"
      stroke-width="6"
    ></circle>
    <circle cx="48" cy="36" r="11" fill="#0a1a30" stroke="#2464d8" stroke-width="2"></circle>
    <circle cx="53" cy="31" r="3.5" fill="#f8fafc"></circle>
    <path
      d="M48 4v9M48 59v9M75 36h8"
      stroke="#10e5d1"
      stroke-width="5"
      stroke-linecap="round"
    ></path>
  </svg>
  <span class="okoscope-brand-copy" translate="no">
    <span class="okoscope-brand-name">
      <strong>OKO</strong>SCOPE
    </span>
    <span class="okoscope-brand-tagline">Runtime observability</span>
  </span>
</a>
