{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.real-backend.config.ts",
    "e2e/real-backend.setup.mjs",
    "e2e/real-backend.teardown.mjs",
    "playwright.docs.config.ts",
    "playwright.screenshots.config.ts"
  ]
}
